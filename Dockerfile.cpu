# ==============================================================================
# Multi-stage Dockerfile for Crane Nemotron Streaming STT Service (Torch-RS / CPU)
# Completely Self-Contained: Compiles Rust with LibTorch C++ and serves TorchScript
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Rust Service Builder with LibTorch C++
# ------------------------------------------------------------------------------
FROM rust:1.85-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    g++ \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-downloaded official LibTorch C++ CPU (v2.4.0)
COPY scratch/libtorch /usr/local/libtorch

ENV LIBTORCH=/usr/local/libtorch
ENV LD_LIBRARY_PATH=/usr/local/libtorch/lib:${LD_LIBRARY_PATH}

WORKDIR /app

# Copy Rust crate sources
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY static ./static

# Build release binary
RUN cargo build --release --bin api_server

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/libtorch/lib:${LD_LIBRARY_PATH}

# Install minimal runtime shared libraries (no Python, no build toolchains)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libasound2 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy LibTorch runtime shared libraries
COPY --from=builder /usr/local/libtorch/lib/ /usr/local/libtorch/lib/
RUN ldconfig /usr/local/libtorch/lib

# 2. Copy compiled Rust service binary
COPY --from=builder /app/target/release/api_server /app/api_server

# 3. Copy TorchScript model weights and tokenizer directly
COPY torchscript_model /app/torchscript_model

# Expose HTTP / WebSocket API port
EXPOSE 8099

# Environment variables
ENV RUST_LOG=info
ENV MODEL_PATH=/app/torchscript_model
ENV PORT=8099

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8099/health || exit 1

# Launch the STT API server
CMD ["/app/api_server"]
