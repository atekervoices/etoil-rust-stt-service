        "to": "/streaming",
        "icon": "phosphor/regular/waveform"
      },
      {
        "title": "Pre-recorded Audio",
        "to": "/batch",
        "icon": "phosphor/regular/files"
      },
      {
        "title": "Languages",
        "to": "/languages",
        "icon": "phosphor/regular/translate"
      },
      {
        "title": "Benchmarks",
        "to": "/benchmarks",
        "icon": "phosphor/regular/gauge"
      },
      {
        "title": "API Reference",
        "to": "/api",
        "icon": "phosphor/regular/terminal-window"
      }
    ],
    "header": [
      {
        "type": "link",
        "title": "API Status",
        "align": "end",
        "to": "https://stt-staging.atekervoices.com/health"
