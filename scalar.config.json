{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "PhosAI Documentation",
    "description": "Ultra-Low Latency Real-Time Speech-to-Text API"
  },
  "siteConfig": {
    "title": "PhosAI Docs",
    "favicon": "https://cdn.scalar.com/marketing/landing/logo-dark.svg",
