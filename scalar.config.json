        "type": "page",
        "filepath": "docs/content/batch.mdx",
        "title": "Pre-recorded Audio",
        "icon": "phosphor/regular/files"
      },
      "/languages": {
        "type": "page",
        "filepath": "docs/content/languages.mdx",
        "title": "Language Support",
        "icon": "phosphor/regular/translate"
      },
      "/benchmarks": {
        "type": "page",
        "filepath": "docs/content/benchmarks.mdx",
        "title": "Latency Benchmarks",
        "icon": "phosphor/regular/gauge"
      },
      "/api": {
        "type": "openapi",
        "filepath": "docs/api-reference/openapi.yaml",
