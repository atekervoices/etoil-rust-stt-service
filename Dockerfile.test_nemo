
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    libsndfile1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /export

RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir torch torchaudio --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    "numpy<2.0" \
    "pyarrow<18.0.0" \
    onnx \
    onnxruntime \
    soundfile \
    sentencepiece \
    huggingface_hub \
    "nemo_toolkit[asr]"

ARG HF_TOKEN=
ENV HF_TOKEN=${HF_TOKEN}

COPY scripts/download_model.py /export/download_model.py
COPY scripts/test_nemo_native.py /export/test_nemo_native.py

CMD ["python3", "/export/test_nemo_native.py"]
